car_prep() {
  # per file: fill empty artist/title from "artist - title" filename,
  # strip junk TXXX, convert to v2.3, then write v1.1 from v2
  echo -e "${yellow}\tCar prep${reset}"
  echo -e "${blue}per file: fill empty artist/title from filename, strip junk TXXX, convert to v2.3, sync v1${reset}"
  local name artist title fill
  for f in *.mp3; do
    name="$(basename "${f%.*}")"
    artist="$(eyeD3 -2 -l error "$f" 2>/dev/null | awk '/^artist:/' | sed 's/^artist: //;s/[[:space:]]*$//')"
    title="$(eyeD3 -2 -l error "$f" 2>/dev/null | awk '/^title:/' | sed 's/^title: //;s/[[:space:]]*$//')"
    if [[ -n "$artist" && -n "$title" ]]; then
      echo -e "${blue}\"$f\"${reset} tags ok"
    elif is_artist_title_name "$name"; then
      echo -e "${blue}\"$f\"${yellow} fill empty artist/title from filename${reset}"
    else
      echo -e "${red}\"$f\" missing artist/title and filename is not \"artist - title\" - fix by hand${reset}"
    fi
  done

  echo -e "${yellow} about to modify all mp3s in PWD"
  are_we_committing
  if [ "$committing" != 'yes' ]; then
    echo -e "${blue}ok... we do nothing then...bailing${reset}"
    return
  fi

  for f in *.mp3; do
    name="$(basename "${f%.*}")"
    artist="$(eyeD3 -2 -l error "$f" 2>/dev/null | awk '/^artist:/' | sed 's/^artist: //;s/[[:space:]]*$//')"
    title="$(eyeD3 -2 -l error "$f" 2>/dev/null | awk '/^title:/' | sed 's/^title: //;s/[[:space:]]*$//')"
    fill=()
    if is_artist_title_name "$name"; then
      [[ -z "$artist" ]] && fill+=(-a "$(echo "${name%% - *}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')")
      [[ -z "$title" ]] && fill+=(-t "$(echo "${name#* - }" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')")
    fi
    if eyeD3 -l error "${fill[@]}" "${junk_txxx_opts[@]}" --to-v2.3 "$f" >/dev/null &&
      eyeD3 -l error --to-v1.1 "$f" >/dev/null; then
      echo -e "${white}Success: ${blue}\"$f\"${reset}"
    else
      echo -e "${red}Failed: \"$f\"${reset}"
    fi
  done
  echo -e ${reset}
} # car_prep

