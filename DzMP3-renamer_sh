is_artist_title_name() {
  # true if "$1" is exactly "artist - title": one " - " with text both sides
  local name="$1" left right
  [[ "$name" == *" - "* ]] || return 1
  left="${name%% - *}"
  right="${name#* - }"
  [[ -n "$left" && -n "$right" && "$right" != *" - "* ]]
} # is_artist_title_name

tag_report() {
  # $1 = problems | full ; compares ID3 v1 and v2 of each mp3 in PWD
  local mode="$1"
  local report="tag-report.txt"
  echo -e "${yellow}\tTag report ($mode)${reset}"
  python3 - "$mode" <<'PY' | tee "$report"
import glob, logging, sys
logging.disable(logging.CRITICAL)
import eyed3
from eyed3 import id3

mode = sys.argv[1]
JUNK = {"major_brand", "minor_version", "compatible_brands"}
ENC = {0: "latin1", 1: "utf16", 2: "utf16be", 3: "utf8"}
FIELDS = ["title", "artist", "album", "track", "year", "genre"]


def load(path, version):
    try:
        af = eyed3.load(path, tag_version=version)
    except Exception:
        return None
    return af.tag if af and af.tag else None


def values(tag):
    if tag is None:
        return None
    date = tag.getBestDate()
    return {
        "title": tag.title or "",
        "artist": tag.artist or "",
        "album": tag.album or "",
        "track": str(tag.track_num[0] or ""),
        "year": str(date.year) if date else "",
        "genre": tag.genre.name if tag.genre and tag.genre.name else "",
    }


def v1_form(field, v2val, v2tag):
    # what eyeD3 would store in v1 for this v2 value
    if field in ("title", "artist", "album"):
        return v2val.encode("latin_1", "replace")[:30].decode("latin_1").strip()
    if field == "genre":
        return v2val if v2tag.genre and v2tag.genre.id is not None else "Other"
    return v2val


def status(field, v2val, v1val, v2tag):
    if v1val is None:
        return "no v1"
    if v1val.strip() == v2val.strip():
        return "ok" if v2val else "-"
    if v1val.strip() == v1_form(field, v2val, v2tag):
        return "ok (v1 limit)"
    return "DIFF"


def cut(s, n=30):
    return s if len(s) <= n else s[: n - 1] + "~"


files = sorted(glob.glob("*.[mM][pP]3"))
if not files:
    print("no mp3 files in this folder")
    sys.exit(0)

counts = {}
problem_files = 0
for path in files:
    t2, t1 = load(path, id3.ID3_V2), load(path, id3.ID3_V1)
    v2, v1 = values(t2), values(t1)
    issues = []
    if t2 is None:
        issues.append(("no v2 tag", "no v2 tag"))
    else:
        if t2.version == id3.ID3_V2_4:
            issues.append(("v2.4 tag", "v2.4 tag - old stereos may need v2.3 (use 23 or car)"))
        for f in ("title", "artist"):
            if not v2[f]:
                issues.append((f"empty v2 {f}", f"v2 {f} is empty"))
        txxx = {fr.description for fr in t2.frame_set.get(b"TXXX", [])}
        if txxx & JUNK:
            issues.append(("junk TXXX", "junk ffmpeg TXXX frames: " + ", ".join(sorted(txxx & JUNK))))
    if t1 is None:
        issues.append(("no v1 tag", "no v1 tag"))
    elif t2 is not None:
        for f in FIELDS:
            if status(f, v2[f], v1[f], t2) == "DIFF":
                issues.append((f"v1 {f} differs", f"v1 {f} differs: v2 '{v2[f]}' / v1 '{v1[f]}'"))

    if issues:
        problem_files += 1
    for key, _ in issues:
        counts[key] = counts.get(key, 0) + 1

    if mode == "full":
        v2desc = "none"
        if t2 is not None:
            encs = {ENC.get(fr.encoding[0] if isinstance(fr.encoding, bytes) else fr.encoding, "?")
                    for frames in t2.frame_set.values() for fr in frames
                    if getattr(fr, "encoding", None) is not None}
            v2desc = id3.versionToString(t2.version) + (" (" + ",".join(sorted(encs)) + ")" if encs else "")
        v1desc = id3.versionToString(t1.version) if t1 is not None else "none"
        print("=" * 100)
        print(path)
        print(f"  v2: {v2desc}   v1: {v1desc}")
        print(f"  {'field':7} {'v2':32} {'v1':32} status")
        for f in FIELDS:
            a = v2[f] if v2 else ""
            b = v1[f] if v1 else ""
            st = status(f, a, v1[f] if v1 else None, t2) if t2 is not None else "no v2"
            print(f"  {f:7} {cut(a):32} {cut(b):32} {st}")
        for _, msg in issues:
            print(f"  ! {msg}")
    else:
        for _, msg in issues:
            print(f"{path}: {msg}")

print("=" * 100 if mode == "full" else "")
print(f"{len(files)} files, {problem_files} with problems")
for key in sorted(counts):
    print(f"  {counts[key]:4}  {key}")
PY
  echo -e "${blue}report saved to ${yellow}$PWD/$report${reset}"
  pause
} # tag_report

